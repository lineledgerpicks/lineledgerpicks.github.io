// Written by `nfl.py publish` from src/site_assets/worker/wrangler.jsonc - edit it there.
{
  "name": "lineledgerpicks-github-io",
  "main": "_worker/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true },
    "issue_detection": { "enabled": false }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/auth/*", "/api/*", "/members.enc"]
  },
  "vars": {
    "WHOP_CLIENT_ID": "app_QqLTYh2VpKukW5",
    "WHOP_PRODUCT_ID": "prod_UAoPTkQjvJAQX",
    "SITE": "https://lineledgerpicks.com",
    "JOIN_URL": "https://whop.com/lineledgerpicks/line-ledger-membership/",
    "DISCORD_CLIENT_ID": "1571949512598229192",
    "DISCORD_GUILD_ID": "1421193448551219352",
    "DISCORD_ROLE_ID": "1571773177158307900"
  },
  "kv_namespaces": [{ "binding": "LINKS", "id": "dbea0ee9d5d1492f91431d0f3dd2f933" }],
  "triggers": { "crons": ["*/2 * * * *"] }
}
